  unitName: "\u9ED2\u8863\u306E\u732B\u9B54\u5973\u30A2\u30EA\u30A2 (6\u2605)"
  unitId: 10815
  unitNumber: 1221
  description: "\u7570\u4E16\u754C\u304B\u3089\u3084\u3063\u3066\u304D\u305F\u9B54\u5973\u3002\u732B\u306E\u8033\u306F\u5730\u3092\u99C6\u3051\u308B\u3042\u3089\u3086\u308B\u8DB3\u97F3\u3092\u805E\u304D\u3001\u8679\u5F69\u8272\u306E\u7570\u306A\u308B\u4E21\u306E\u77B3\u306F\u305D\u308C\u305E\u308C\u306B\u5225\u306E\u4E16\u754C\u3092\u898B\u3066\u3044\u308B\u3068\u8A00\u308F\u308C\u3066\u3044\u308B\u3002\u304B\u3064\u3066\u306F\u201C\u5C01\u9B54\u754C\u201D\u3068\u547C\u3070\u308C\u308B\u3001\u9B54\u6CD5\u306E\u529B\u5F37\u304D\u8005\u304C\u4E16\u3092\u675F\u306D\u308B\u307E\u305F\u5225\u7A2E\u306E\u7570\u754C\u306B\u66AE\u3089\u3057\u3066\u3044\u305F\u3053\u3068\u3082\u3042\u308A\u3001\u5049\u5927\u306A\u308B\u9B54\u5973\u3068\u3057\u3066\u754F\u308C\u3089\u308C\u3066\u3044\u305F\u3002\u73FE\u5728\u306F\u591A\u304F\u306E\u4EBA\u9593\u3068\u306E\u4EA4\u6D41\u3092\u901A\u3058\u3066\u52A0\u6E1B\u3059\u308B\u3053\u3068\u3092\u5B66\u3093\u3060\u304C\u3001\u9B54\u529B\u8CAF\u8535\u91CF\u306F\u904E\u53BB\u306B\u3082\u5897\u3057\u3066\u81A8\u308C\u3042\u304C\u3063\u3066\u3044\u308B\u3002"
  summonDesc: "\u79C1\u3092\u8AB0\u304B\u77E5\u3089\u3093\u3060\u3068\uFF1F<br>\u30AF\u30AF\u3001\u306A\u3089\u3070\u898B\u305B\u3066\u3084\u308D\u3046\u2026<br>\u5049\u5927\u306A\u308B\u9B54\u5973\u306E\u6050\u6016\u3068\u3044\u3046\u3084\u3064\u3092\uFF01"
  fusionDesc: "\u9B54\u529B\u304C\u3042\u3075\u308C\u51FA\u3057\u3066\u304F\u308B\u2026<br>\u3053\u308C\u306F\u3082\u3057\u3084\u3001<br>\u30A2\u30EA\u30A2\u69D8\u53F2\u4E0A\u6700\u5F37\u306A\u3093\u3058\u3083\u306A\u3044\u304B\uFF1F"
  evoDesc: "\u30AF\u30AF\u30AF\u2026\u529B\u304C\u307F\u306A\u304E\u3063\u3066\u304F\u308B\u305E\u3002<br>\u529B\u8A66\u3057\u306B\u4E00\u6226\u4EA4\u3048\u3066\u307F\u308B\u304B\uFF1F<br>\u305F\u3060\u3057\u3001\u547D\u306E\u4FDD\u8A3C\u306F\u3067\u304D\u3093\u305E\uFF1F"
