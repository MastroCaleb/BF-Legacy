  unitName: "\u6E05\u6DBC\u306E\u51DB\u5263\u58EB\u30AB\u30A4\u30C8 (6\u2605)"
  unitId: 20745
  unitNumber: 1223
  description: "\u7570\u4E16\u754C\u304B\u3089\u3084\u3063\u3066\u304D\u305F\u5263\u58EB\u3002\u6C34\u9762\u3092\u5272\u308B\u307B\u3069\u306E\u5353\u8D8A\u3057\u305F\u5263\u306E\u8155\u524D\u3092\u6301\u3063\u3066\u3044\u308B\u3002\u305D\u306E\u6B63\u4F53\u306F\u3001\u304B\u3064\u3066\u4F1D\u8AAC\u306E\u9A0E\u58EB\u304C\u64CD\u308B\u5343\u306E\u6B66\u5668\u306E\u4E00\u632F\u308A\u3060\u3063\u305F\u3082\u306E\u304C\u3001\u4E94\u767E\u5E74\u306E\u6642\u3092\u7D4C\u3066\u4EBA\u9593\u3078\u3068\u8EE2\u751F\u3057\u305F\u201C\u30EA\u30BF\u30FC\u30CA\u30FC\u201D\u3068\u547C\u3070\u308C\u308B\u6226\u58EB\u3067\u3042\u308B\u3002\u672C\u4EBA\u306F\u81EA\u5206\u304C\u5263\u3060\u3063\u305F\u904E\u53BB\u306E\u8A18\u61B6\u3092\u5931\u3063\u3066\u3044\u308B\u304C\u3001\u304B\u3064\u3066\u306E\u9298\u306F\u201C\u65AC\u6C34\u306E\u51DB\u5263\u201D\u3002\u6C34\u3059\u3089\u65AD\u3061\u5207\u308B\u3068\u8B33\u308F\u308C\u305F\u540D\u5263\u306E\u529B\u306F\u73FE\u4E16\u3092\u751F\u304D\u308B\u5263\u58EB\u306E\u4E2D\u306B\u3082\u3057\u3063\u304B\u308A\u3068\u606F\u3065\u3044\u3066\u3044\u308B\u3002"
  summonDesc: "\u3055\u3042\u3001\u884C\u3053\u3046\u304B\u3002<br>\u50D5\u304C\u305F\u3063\u3077\u308A\u52DD\u3061\u661F\u3092\u7A3C\u3044\u3067\u3042\u3052\u308B\u3002<br>\u306A\u3093\u3060\u3063\u305F\u3089\u541B\u306F\u4F11\u3093\u3067\u3066\u3044\u3044\u3088\u3002"
  fusionDesc: "\u529B\u304C\u6E80\u3061\u6EA2\u308C\u3066\u304F\u308B\u2026<br>\u3053\u3044\u3064\u5408\u6210\u306E\u52B9\u679C\u3063\u3066\u308F\u3051\u304B\u3002<br>\u306A\u308B\u307B\u3069\u3001\u78BA\u304B\u306B\u60AA\u304F\u306A\u3044\u304B\u3082\u306D\u3002"
  evoDesc: "\u50D5\u306E\u5263\u306F\u3055\u3089\u306B\u5207\u308C\u5473\u3092\u5897\u3057\u3066\u308B\u3002<br>\u304A\u3044\u305D\u308C\u3068\u8CA0\u3051\u3084\u3057\u306A\u3044\u3001<br>\u541B\u3092\u5B88\u308A\u306A\u304C\u3089\u3060\u3063\u3066\u6226\u3048\u308B\u3055\u3002"
