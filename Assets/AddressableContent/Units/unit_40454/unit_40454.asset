  unitName: "\u96F7\u7206\u306E\u5973\u795E\u30D5\u30A7\u30CB\u30A2"
  unitId: 40454
  unitNumber: 603
  description: "\u7A81\u5982\u3001\u7570\u754C\u3088\u308A\u73FE\u308C\u3001\u7279\u6B8A\u306A\u6A5F\u68B0\u5175\u5668\u3092\u64CD\u308A\u6226\u3046\u5C11\u5973\u305F\u3061\u201C\u30D0\u30C8\u30EB\u30E1\u30A4\u30C7\u30F3\u201D\u306E\uFF11\u4EBA\u3002\u30D0\u30C8\u30EB\u30E1\u30A4\u30C7\u30F3\u306E\u4EF2\u9593\u305F\u3061\u3068\u65C5\u3092\u7D9A\u3051\u3066\u3044\u305F\u5F7C\u5973\u306F\u3001\u7A81\u5982\u5931\u3063\u3066\u3044\u305F\u8A18\u61B6\u3092\u56DE\u5FA9\u3059\u308B\u3002\u305D\u3057\u3066\u305D\u306E\u76F4\u5F8C\u3001\u30D5\u30A7\u30CB\u30A2\u306F\u795E\u3005\u304C\u4EBA\u9593\u306B\u5927\u4FB5\u653B\u3092\u304B\u3051\u3066\u304F\u308B\u3053\u3068\u3092\u4E88\u8A00\u3002\u305D\u306E\u8A00\u8449\u3092\u5143\u306B\u4EF2\u9593\u306E\u30BB\u30EA\u30F3\u304C\u7ACB\u6848\u3057\u305F\u8FCE\u6483\u4F5C\u6226\u306B\u52A0\u308F\u3063\u305F\u5F7C\u5973\u306F\u3001\u795E\u3005\u306E\u72A0\u7272\u306B\u306A\u3063\u305F\u6570\u591A\u304F\u306E\u4EBA\u3005\u306E\u305F\u3081\u3001\u529B\u306E\u9650\u308A\u795E\u8ECD\u3068\u6226\u3063\u305F\u3068\u3055\u308C\u308B\u3002"
  summonDesc: "\u3048\u3001\u30AD\u30DF\u3082\u4EBA\u3092\u52A9\u3051\u305F\u3044\u306E\uFF1F<br>\u3084\u3063\u305F\u3042\uFF01\u4E00\u7DD2\u306B\u30AC\u30F3\u30D0\u308D\u3046\u306D\uFF01<br>\u305F\u3060\u3057\u30DC\u30AF\u306E\u7206\u5F3E\u306B\u306F\u6C17\u3092\u3064\u3051\u3066\u306D\uFF5E\u3002"
  fusionDesc: "\u3053\u306E\u5408\u6210\u3063\u3066\u3084\u3064\u306F\u3001<br>\u3044\u3064\u3082\u30DC\u30AF\u3092\u8208\u596E\u3055\u305B\u308B\u306D\u3002<br>\u3082\u3046\u30D3\u30E5\u30F3\u30D3\u30E5\u30F3\u5F3E\u3051\u305D\u3046\u3060\u3088\uFF01"
  evoDesc: "\u5E78\u904B\u306F\u52C7\u6C17\u306B\u5BBF\u308B\u3093\u3060\u3088\uFF01<br>\u3048\u3001\u30DC\u30AF\u306B\u5BBF\u3063\u3066\u3044\u308B\u304B\u3060\u3063\u3066\uFF1F<br>\u305D\u3093\u306A\u3053\u3068\u805E\u304F\u307E\u3067\u3082\u306A\u3044\u3088\u306D\u3002"
