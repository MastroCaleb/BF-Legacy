  unitName: "\u51A5\u6708\u306E\u9280\u59B9\u30ED\u30CD\u30C3\u30B5 (6\u2605)"
  unitId: 60905
  unitNumber: 1231
  description: "\u7570\u4E16\u754C\u304B\u3089\u3084\u3063\u3066\u304D\u305F\u938C\u4F7F\u3044\u306E\u5C11\u5973\u3002\u5E74\u9F62\u4E0D\u76F8\u5FDC\u306E\u51B7\u9177\u306A\u6226\u95D8\u8005\u3067\u3001\u4E16\u754C\u3067\u6700\u3082\u611B\u3059\u308B\u59C9\u3092\u3044\u3064\u304B\u81EA\u5206\u306E\u624B\u306B\u304B\u3051\u305F\u3044\u3068\u9858\u3063\u3066\u3044\u308B\u3002\u305D\u306E\u6B63\u4F53\u306F\u3001\u304B\u3064\u3066\u4F1D\u8AAC\u306E\u9A0E\u58EB\u304C\u64CD\u308B\u5343\u306E\u6B66\u5668\u306E\u4E00\u632F\u308A\u3060\u3063\u305F\u3082\u306E\u304C\u4E94\u767E\u5E74\u306E\u6642\u3092\u7D4C\u3066\u4EBA\u9593\u3078\u3068\u8EE2\u751F\u3057\u305F\u201C\u30EA\u30BF\u30FC\u30CA\u30FC\u201D\u3068\u547C\u3070\u308C\u308B\u6226\u58EB\u3067\u3042\u308B\u3002\u672C\u4EBA\u306F\u4EE5\u524D\u306E\u8A18\u61B6\u3092\u5931\u3063\u3066\u3044\u308B\u304C\u304B\u3064\u3066\u306E\u9298\u306F\u201C\u66AE\u95C7\u306E\u51A5\u938C\u201D\u3002\u59C9\u30F4\u30A1\u30CD\u30C3\u30B5\u3068\u540C\u3058\u8077\u4EBA\u306E\u624B\u3067\u9020\u3089\u308C\u305F\u6B7B\u306E\u938C\u3060\u3063\u305F\u3002"
  summonDesc: "\u521D\u3081\u307E\u3057\u3066\u3001\u30ED\u30CD\u30C3\u30B5\u3067\u3059\u30FC\u3002<br>\u597D\u304D\u306A\u4EBA\u306F\u304A\u59C9\u3061\u3083\u3093\u3001<br>\u3076\u3063\u58CA\u3057\u305F\u3044\u4EBA\u3082\u304A\u59C9\u3061\u3083\u3093\u3067\u3059\uFF01"
  fusionDesc: "\u65B0\u3057\u3044\u529B\u3092\u624B\u306B\u5165\u308C\u308B\u3068\u306D\u3001<br>\u8A66\u3057\u306B\u4F7F\u3044\u305F\u304F\u306A\u308A\u307E\u3059\u3088\u306D\uFF01<br>\u3044\u3089\u306A\u3044\u4EBA\u306F\u3069\u3063\u3053\u304B\u306A\u30FC\uFF1F\u266A"
  evoDesc: "\u5F37\u304F\u306A\u308A\u3059\u304E\u3067\u9A5A\u304D\u3067\u3059\u304B\uFF1F<br>\u6210\u9577\u671F\u30CA\u30E1\u3066\u3093\u3058\u3083\u306A\u3044\u3067\u3059\u3088\uFF1F<br>\u305D\u3044\u3067\u3044\u3064\u304B\u304A\u59C9\u3061\u3083\u3093\u3092\u2026"
