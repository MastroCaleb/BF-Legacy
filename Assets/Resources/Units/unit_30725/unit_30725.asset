  unitName: "\u722A\u9CF4\u306E\u59EB\u732B\u30AF\u30FC\u30E9\u30F3 (6\u2605)"
  unitId: 30725
  unitNumber: 1225
  description: "\u7570\u4E16\u754C\u304B\u3089\u3084\u3063\u3066\u304D\u305F\u732B\u8033\u306E\u5973\u6226\u58EB\u3002\u4FCA\u654F\u306A\u8EAB\u632F\u308A\u3067\u6575\u3092\u7FFB\u5F04\u3059\u308B\u3002\u5999\u306B\u98DF\u3044\u610F\u5730\u304C\u5F35\u3063\u3066\u3044\u308B\u306E\u306F\u3054\u611B\u656C\u3001\u732B\u3086\u3048\u306B\u81F4\u3057\u65B9\u306A\u3057\u3002\u305D\u306E\u6B63\u4F53\u306F\u3001\u304B\u3064\u3066\u4F1D\u8AAC\u306E\u9A0E\u58EB\u304C\u64CD\u308B\u5343\u306E\u6B66\u5668\u306E\u4E00\u632F\u308A\u3060\u3063\u305F\u3082\u306E\u304C\u4E94\u767E\u5E74\u306E\u6642\u3092\u7D4C\u3066\u4EBA\u9593\u3078\u3068\u8EE2\u751F\u3057\u305F\u201C\u30EA\u30BF\u30FC\u30CA\u30FC\u201D\u3068\u547C\u3070\u308C\u308B\u6226\u58EB\u3067\u3042\u308B\u3002\u672C\u4EBA\u306F\u4EE5\u524D\u306E\u8A18\u61B6\u3092\u5931\u3063\u3066\u3044\u308B\u304C\u3001\u304B\u3064\u3066\u306E\u9298\u306F\u201C\u92ED\u9CF4\u306E\u7363\u722A\u201D\u3002\u9B54\u529B\u306E\u5171\u632F\u306B\u3088\u308A\u5207\u308C\u5473\u3092\u5897\u5E45\u3055\u305B\u308B\u5F37\u529B\u306A\u9264\u722A\u3060\u3063\u305F\u3002"
  summonDesc: "\u30AF\u30FC\u30E9\u30F3\u304C\u6765\u305F\u304B\u3089\u306B\u306F\u3082\u3046\u5B89\u5FC3\u3001<br>\u92ED\u3044\u55C5\u899A\u3068\u722A\u3067\u541B\u3092\u30B5\u30DD\u30FC\u30C8\u306B\u3083\u3002<br>\u3060\u304B\u3089\u307E\u305A\u7518\u3044\u3082\u306E\u3092\u9802\u6234\u3060\u306B\u3083\u3002"
  fusionDesc: "\u5F37\u304F\u3057\u3066\u304F\u308C\u3066\u3042\u308A\u304C\u3068\u306B\u3083\u3002<br>\u3069\u3093\u306A\u6575\u304C\u6765\u3088\u3046\u3068\u3001<br>\u3053\u306E\u722A\u3067\u4E00\u7DB2\u6253\u5C3D\u3060\u306B\u3083\uFF01"
  evoDesc: "\u732B\u306A\u308A\u306E\u52AA\u529B\u306E\u7D50\u679C\u306B\u3083\u3002<br>\u65B0\u3057\u3044\u30AF\u30FC\u30E9\u30F3\u306E\u722A\u306F\u3055\u306A\u304C\u3089\u864E\uFF01<br>\u92ED\u3044\u4E00\u6483\u3092\u6575\u306B\u304A\u898B\u821E\u3044\u306B\u3083\u3002"
