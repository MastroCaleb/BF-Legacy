  description: "\u9759\u304B\u306A\u68EE\u3067\u7236\u89AA\u3068\u66AE\u3089\u3057\u3066\u3044\u305F\u5C11\u5973\u3002\u30B8\u30E3\u30C3\u30AF\u304C\u72C2\u6C17\u306E\u9A0E\u58EB\u3092\u5012\u3057\u305F\u5F8C\u3001\u30BB\u30DF\u30E9\u306F\u9A0E\u58EB\u306E\u9B42\u306B\u6191\u4F9D\u3057\u3066\u3044\u305F\u60AA\u970A\u3092\u5236\u5FA1\u3067\u304D\u308B\u3088\u3046\u306B\u306A\u308B\u307E\u3067\u6210\u9577\u3057\u3066\u3044\u304F\u3002\u60AA\u970A\u3092\u81EA\u5206\u306E\u5B88\u8B77\u970A\u3078\u3068\u5909\u5316\u3055\u305B\u308B\u3068\u3001\u68EE\u306E\u4E2D\u306B\u672A\u3060\u8513\u5EF6\u3063\u3066\u3044\u308B\u69D8\u3005\u306A\u60AA\u970A\u3092\u9000\u6CBB\u3059\u308B\u3053\u3068\u3092\u6C7A\u610F\u3059\u308B\u3002\u6697\u3044\u68EE\u306B\u71E6\u7136\u3068\u8F1D\u304F\u59FF\u306F\u201C\u9B54\u708E\u306E\u756A\u4EBA\u201D\u3068\u3057\u3066\u60AA\u970A\u305F\u3061\u304B\u3089\u6050\u308C\u3089\u308C\u3001\u3069\u308C\u3060\u3051\u5F37\u5927\u306A\u60AA\u970A\u3067\u3082\u5F7C\u5973\u3092\u8972\u3046\u3053\u3068\u3092\u907F\u3051\u305F\u3068\u3044\u3046\u3002"
  summonDesc: "\u672C\u5F53\u306B\u3044\u3044\u306E\uFF1F<br>\u6700\u5F37\u306E\u5B88\u308A\u795E\u3068\u4E00\u7DD2\u306B<br>\u6D3E\u624B\u306B\u66B4\u308C\u3055\u305B\u3066\u3082\u3089\u3046\u3051\u3069\uFF01"
  fusionDesc: "\u8AB0\u304B\u304C\u8B77\u3063\u3066\u304F\u308C\u308B\u306E\u3092\u611F\u3058\u308B\u3002<br>\u305D\u308C\u306B\u3001\u30B8\u30E3\u30C3\u30AF\u3068\u4E00\u7DD2\u3060\u3063\u305F\u3089<br>\u3069\u3093\u306A\u76F8\u624B\u3068\u3067\u3082\u6226\u3048\u308B\u308F\uFF01"
  evoDesc: "\u30D5\u30D5\u30C3\u3001\u3059\u3079\u3066\u304C\u5909\u308F\u3063\u305F\u308F\u306D\u3002<br>\u3042\u306A\u305F\u306B\u3082\u898B\u305B\u3066\u3042\u3052\u308B\u3002<br>\u714C\u3081\u304F\u9B54\u708E\u306E\u4E16\u754C\u3092\uFF01"
